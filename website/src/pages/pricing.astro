  </head>
  <body class="bg-slate-950 text-slate-300 font-sans flex items-center justify-center min-h-screen">
    <div class="text-center p-6 max-w-md">
      <p class="text-base mb-3">Redirecting to plans and pricing...</p>
      <a href="/plans" class="text-emerald-400 underline hover:text-emerald-300">Click here if you are not redirected automatically.</a>
