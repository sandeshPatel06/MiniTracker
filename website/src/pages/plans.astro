---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';

const plansJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://minitracker.pages.dev',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Plans & Pricing',
          item: 'https://minitracker.pages.dev/plans',
        },
      ],
    },
    {
      '@type': 'Product',
      name: 'MiniTracker (get-Hike)',
      description: 'Open-source, privacy-first productivity tracking. Free BYOK community edition, managed Team Pro cloud, and dedicated Enterprise instances.',
      offers: [
        {
          '@type': 'Offer',
          name: 'Free Community (BYOK)',
          price: '0.00',
          priceCurrency: 'USD',
          availability: 'https://schema.org/InStock',
        },
        {
          '@type': 'Offer',
          name: 'Team Pro (Managed Cloud)',
          price: '8.00',
          priceCurrency: 'USD',
          availability: 'https://schema.org/PreOrder',
        },
        {
          '@type': 'Offer',
          name: 'Enterprise',
          priceCurrency: 'USD',
          availability: 'https://schema.org/PreOrder',
        },
      ],
    },
  ],
};

const comparisonMatrix = [
  {
    feature: 'Core Tracking Engine',
    category: 'Core Telemetry',
    free: 'Shannon entropy & input dynamics',
    team: 'Shannon entropy & input dynamics',
    enterprise: 'Custom entropy & custom sampling rates',
  },
  {
    feature: 'Gemini AI Batch Classification',
    category: 'AI & Intelligence',
    free: 'BYOK (Personal Google Gemini key)',
    team: 'Managed (Zero key setup required)',
    enterprise: 'Managed + Custom prompt/fine-tuned policies',
  },
  {
    feature: 'AI Failover & Batching',
    category: 'AI & Intelligence',
    free: 'gemini-3.5-flash-lite failovers',
    team: 'High-throughput automated queueing',
    enterprise: 'Dedicated quota & SLA-backed throughput',
  },
  {
    feature: 'Sensitive Window Auto-Blur',
    category: 'Privacy & Security',
    free: 'In-memory secret regex & 3 blur modes',
    team: 'In-memory secret regex & team-wide rules',
    enterprise: 'Custom proprietary pattern sets & DLP audit',
  },
  {
    feature: 'Distraction Guard & Dwell Alerts',
    category: 'Productivity Guard',
    free: '45s grace period, 10m/30m snooze',
    team: 'Team goal suppression & work policies',
    enterprise: 'Centralized org-wide distraction policies',
  },
  {
    feature: 'Idle & Away Categorization',
    category: 'Productivity Guard',
    free: 'D-Bus/X11 monitors + keyboard modal',
    team: 'Shared project taxonomy auto-matching',
    enterprise: 'HR/ERP system sync & custom tags',
  },
  {
    feature: 'Screenshot Storage',
    category: 'Persistence & Cloud',
    free: 'Local-only disk with automated pruning',
    team: 'Telegram cloud encrypted sync & backup',
    enterprise: 'S3-compatible bucket or on-prem blob store',
  },
  {
    feature: 'Database Backend',
    category: 'Persistence & Cloud',
    free: 'Local SQLite (~/.local/share/get-hike/)',
    team: 'Multi-tenant TiDB / Serverless SQL',
    enterprise: 'Dedicated PostgreSQL or self-hosted cluster',
  },
  {
    feature: 'Team Dashboard & Web Portal',
    category: 'Collaboration',
    free: 'Single-user local dashboard',
    team: 'Central org portal with role-based access',
    enterprise: 'Custom domain, white-label, audit logs',
  },
  {
    feature: 'SSO & Authentication',
    category: 'Authentication',
    free: 'Zero-login Guest mode / Local PIN',
    team: 'Google Workspace & Microsoft 365 OAuth',
    enterprise: 'SAML 2.0, Okta, Azure AD, Enforced 2FA',
  },
  {
    feature: 'Support & Uptime SLA',
    category: 'Support',
    free: 'Community GitHub Issues & Discussions',
    team: 'Priority email & Discord channel',
    enterprise: '99.9% uptime SLA & dedicated Slack/rep',
  },
];

const faqs = [
  {
    question: 'Can our team use MiniTracker today for free?',
    answer:
      'Yes, 100%. The core desktop client is fully open-source under the MIT license and is completely free forever. You and every member of your team can install the binaries, track activity, review local timeline captures, and use Bring Your Own Key (BYOK) AI scoring without paying a dime or creating a cloud account.',
  },
  {
    question: 'How does Bring Your Own Key (BYOK) work?',
    answer:
      'In the Free Community tier, you generate a personal API key from Google AI Studio and paste it into MiniTracker’s Settings. MiniTracker makes outbound calls directly from your local workstation to Google’s Gemini API (defaulting to gemini-3.5-flash-lite) to classify 5-minute work intervals. No proxy servers, telemetry brokers, or middleman intermediaries ever touch your API key or activity prompts.',
  },
  {
    question: 'When will team cloud subscriptions launch?',
    answer:
      'Team Pro and Enterprise subscriptions are currently in active development for Q1 2027. We are hardening multi-tenant team sync, managed AI pooling, and encrypted Telegram cloud screenshot storage. You can join the waitlist today to receive early access invitations and lock in early-bird pricing.',
  },
  {
    question: 'Will the open-source client always remain free?',
    answer:
      'Yes. Our core mission is absolute transparency and developer autonomy. The desktop application, local SQLite persistence, entropy detection, sensitive window redaction, and BYOK AI architecture will always be open source under the MIT license.',
  },
  {
    question: 'How does Telegram cloud screenshot storage work in Team Pro?',
    answer:
      'Team Pro pairs with an encrypted Telegram bot storage pipeline. Screenshots captured during work sessions are client-side encrypted before uploading to a private channel or dedicated enterprise container. This provides virtually unlimited, cost-effective media backup while preserving end-to-end data safety.',
  },
];
---

<BaseLayout
  title="Plans & Pricing: Free Open Source & Organization Tiers"
  description="Transparent plans for developers and growing teams. Use MiniTracker for free forever with your own Gemini API key, or join the waitlist for managed Team Pro."
  jsonLd={plansJsonLd}
>
  <main id="main-content" class="relative overflow-hidden pt-12 pb-24 lg:pt-20 lg:pb-32">
    <!-- Ambient Background Accents -->
    <div class="pointer-events-none absolute -top-40 left-1/2 -translate-x-1/2 w-[1000px] h-[500px] bg-radial from-emerald-500/10 via-emerald-500/5 to-transparent blur-3xl -z-10" aria-hidden="true"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Page Header -->
      <header class="text-center max-w-3xl mx-auto mb-16 lg:mb-20">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-mono uppercase tracking-widest mb-6">
          <span class="size-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Zero Surveillance Lock-In</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight sm:leading-tight lg:leading-tight">
          Predictable, transparent plans for <span class="text-emerald-400">individuals and teams.</span>
        </h1>
        <p class="mt-5 text-base sm:text-lg text-slate-300 leading-relaxed">
          Start tracking locally today with 100% free open-source software and your own Gemini API key. Upgrade to managed cloud orchestration when your engineering team scales.
        </p>
      </header>

      <!-- 3 Tier Pricing Cards Grid -->
      <section class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 items-stretch mb-24" aria-label="Subscription Plans">
        
        <!-- CARD 1: Free Community (BYOK) -->
        <article class="relative flex flex-col rounded-2xl bg-slate-900/70 border border-emerald-500/25 p-6 lg:p-8 backdrop-blur-sm hover:border-emerald-500/40 transition-all duration-200">
          <div class="flex items-center justify-between gap-2 mb-4">
            <span class="text-xs font-mono uppercase tracking-wider text-emerald-400 font-semibold px-2.5 py-1 rounded-md bg-emerald-500/10 border border-emerald-500/20">
              Community Edition
            </span>
            <span class="inline-flex items-center gap-1.5 text-[11px] font-mono text-emerald-300 bg-emerald-950/60 px-2 py-0.5 rounded border border-emerald-500/30">
              <span class="size-1.5 rounded-full bg-emerald-400"></span>
              Available Today
            </span>
          </div>

          <h2 class="text-2xl font-bold text-white tracking-tight">Free Community</h2>
          <p class="text-xs text-slate-400 mt-1 font-mono">Bring Your Own Key (BYOK)</p>

          <p class="mt-4 text-sm text-slate-300 min-h-[40px] leading-relaxed">
            For individual developers, freelancers, and open-source contributors who demand local data sovereignty.
          </p>

          <!-- Price Indicator -->
          <div class="my-6 pb-6 border-b border-slate-800">
            <div class="flex items-baseline gap-1">
              <span class="text-4xl lg:text-5xl font-extrabold text-white tracking-tight">$0</span>
              <span class="text-slate-400 text-sm font-medium">/ month</span>
            </div>
            <p class="text-xs text-emerald-400/90 mt-1 font-mono">Free forever • MIT Licensed • Zero credit card</p>
          </div>

          <!-- Feature List -->
          <ul class="space-y-3 text-sm text-slate-300 mb-8 flex-1">
            <li class="flex items-start gap-2.5">
              <svg class="w-4 h-4 text-emerald-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              <span><strong>Unlimited focus tracking</strong> on Linux, Windows & macOS</span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="w-4 h-4 text-emerald-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              <span><strong>BYOK Gemini AI scoring</strong> (direct connection via personal API key)</span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="w-4 h-4 text-emerald-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              <span><strong>In-memory secret auto-blur</strong> for API keys, tokens & credit cards</span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="w-4 h-4 text-emerald-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              <span><strong>Shannon keystroke entropy</strong> with zero keylogging</span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="w-4 h-4 text-emerald-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              <span><strong>Local SQLite storage</strong> with customizable screenshot retention</span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="w-4 h-4 text-emerald-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              <span><strong>Smart Distraction Alerts</strong> with 45s grace debounce & snooze</span>
            </li>
          </ul>

          <!-- Action Button -->
          <Button href="/download" variant="primary" class="w-full text-center font-semibold">
            Download Now (Free)
          </Button>
        </article>

        <!-- CARD 2: Team Pro (Managed Cloud) - Highlighted -->
        <article class="relative flex flex-col rounded-2xl bg-gradient-to-b from-slate-900/90 to-slate-900/70 border-2 border-emerald-500/50 p-6 lg:p-8 backdrop-blur-sm shadow-xl shadow-emerald-500/10">
          <!-- Top Badge Ribbon -->
          <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-emerald-500 text-slate-950 text-xs font-bold font-mono uppercase tracking-wider px-3.5 py-1 rounded-full shadow-md shadow-emerald-500/30">
            Most Popular for Teams
          </div>

          <div class="flex items-center justify-between gap-2 mb-4 mt-2">
            <span class="text-xs font-mono uppercase tracking-wider text-emerald-400 font-semibold px-2.5 py-1 rounded-md bg-emerald-500/10 border border-emerald-500/20">
              Managed Cloud
            </span>
            <span class="inline-flex items-center gap-1.5 text-[11px] font-mono text-amber-300 bg-amber-950/40 px-2 py-0.5 rounded border border-amber-500/30 font-semibold">
              <span class="size-1.5 rounded-full bg-amber-400"></span>
              Coming Soon (Q1 2027)
            </span>
          </div>

          <h2 class="text-2xl font-bold text-white tracking-tight">Team Pro</h2>
          <p class="text-xs text-slate-400 mt-1 font-mono">Managed AI & Multi-Member Sync</p>

          <p class="mt-4 text-sm text-slate-300 min-h-[40px] leading-relaxed">
            For engineering squads and agencies who want automated productivity intelligence without managing individual API credentials.
          </p>

          <!-- Price Indicator -->
          <div class="my-6 pb-6 border-b border-slate-800">
            <div class="flex items-baseline gap-1">
              <span class="text-4xl lg:text-5xl font-extrabold text-white tracking-tight">$8</span>
              <span class="text-slate-400 text-sm font-medium">/ member / month</span>
            </div>
            <p class="text-xs text-slate-400 mt-1 font-mono">Billed monthly or annually • 14-day free trial at launch</p>
          </div>

          <!-- Feature List -->
          <ul class="space-y-3 text-sm text-slate-300 mb-8 flex-1">
            <li class="flex items-start gap-2.5">
              <svg class="w-4 h-4 text-emerald-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              <span><strong>Managed Gemini AI classification</strong> (no personal API key required)</span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="w-4 h-4 text-emerald-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              <span><strong>Telegram Cloud screenshot storage</strong> with client-side encryption</span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="w-4 h-4 text-emerald-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              <span><strong>Central web dashboard</strong> with role-based member permissions</span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="w-4 h-4 text-emerald-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              <span><strong>Automated weekly productivity digests</strong> & burn-out velocity warnings</span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="w-4 h-4 text-emerald-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              <span><strong>Multi-tenant TiDB / Serverless SQL</strong> sync backend</span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="w-4 h-4 text-emerald-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              <span><strong>Google Workspace & Microsoft 365</strong> OAuth team invite flow</span>
            </li>
          </ul>

          <!-- Action Button -->
          <Button href="#waitlist-section" variant="outline" class="w-full text-center font-semibold border-emerald-400 bg-emerald-500/20 text-emerald-300 hover:bg-emerald-500/30">
            Join Team Waitlist
          </Button>
        </article>

        <!-- CARD 3: Enterprise -->
        <article class="relative flex flex-col rounded-2xl bg-slate-900/70 border border-emerald-500/25 p-6 lg:p-8 backdrop-blur-sm hover:border-emerald-500/40 transition-all duration-200">
          <div class="flex items-center justify-between gap-2 mb-4">
            <span class="text-xs font-mono uppercase tracking-wider text-emerald-400 font-semibold px-2.5 py-1 rounded-md bg-emerald-500/10 border border-emerald-500/20">
              Enterprise
            </span>
            <span class="inline-flex items-center gap-1.5 text-[11px] font-mono text-amber-300 bg-amber-950/40 px-2 py-0.5 rounded border border-amber-500/30 font-semibold">
              <span class="size-1.5 rounded-full bg-amber-400"></span>
              Coming Soon
            </span>
          </div>

          <h2 class="text-2xl font-bold text-white tracking-tight">Enterprise</h2>
          <p class="text-xs text-slate-400 mt-1 font-mono">Dedicated & Self-Hosted Infrastructure</p>

          <p class="mt-4 text-sm text-slate-300 min-h-[40px] leading-relaxed">
            For organizations with strict compliance, SOC2 requirements, dedicated cloud clusters, and custom DLP security policies.
          </p>

          <!-- Price Indicator -->
          <div class="my-6 pb-6 border-b border-slate-800">
            <div class="flex items-baseline gap-1">
              <span class="text-4xl lg:text-5xl font-extrabold text-white tracking-tight">Custom</span>
            </div>
            <p class="text-xs text-slate-400 mt-1 font-mono">Tailored seat volume • Annual invoicing</p>
          </div>

          <!-- Feature List -->
          <ul class="space-y-3 text-sm text-slate-300 mb-8 flex-1">
            <li class="flex items-start gap-2.5">
              <svg class="w-4 h-4 text-emerald-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              <span><strong>Dedicated isolated PostgreSQL cluster</strong> or on-prem deployment</span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="w-4 h-4 text-emerald-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              <span><strong>SAML 2.0 / Okta / Azure AD SSO</strong> with automated SCIM provisioning</span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="w-4 h-4 text-emerald-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              <span><strong>Custom AI system prompt policies</strong> & proprietary taxonomy tuning</span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="w-4 h-4 text-emerald-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              <span><strong>Audit logging & compliance exports</strong> (SOC2, HIPAA, GDPR ready)</span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="w-4 h-4 text-emerald-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              <span><strong>S3-compatible custom bucket storage</strong> with customer-managed keys</span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="w-4 h-4 text-emerald-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              <span><strong>99.9% uptime SLA</strong> & dedicated solutions architect support</span>
            </li>
          </ul>

          <!-- Action Button -->
          <Button href="mailto:contact@reak.in?subject=MiniTracker%20Enterprise%20Inquiry" variant="outline" class="w-full text-center font-semibold">
            Contact Sales
          </Button>
        </article>
      </section>

      <!-- Feature Comparison Table Section -->
      <section class="mb-24" aria-label="Feature Comparison Matrix">
        <div class="text-center max-w-2xl mx-auto mb-10">
          <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
            Detailed Tier Comparison
          </h2>
          <p class="mt-2 text-sm sm:text-base text-slate-400">
            Compare capabilities across Community, Team Cloud, and Enterprise tiers.
          </p>
        </div>

        <div class="overflow-x-auto rounded-xl border border-emerald-500/20 bg-slate-900/60 shadow-xl backdrop-blur-sm">
          <table class="w-full text-left border-collapse min-w-[700px]">
            <thead>
              <tr class="border-b border-emerald-500/20 bg-slate-950/80">
                <th scope="col" class="py-4 px-6 text-xs font-mono uppercase tracking-wider text-slate-300 w-1/3">
                  Capability / Feature
                </th>
                <th scope="col" class="py-4 px-6 text-xs font-mono uppercase tracking-wider text-emerald-400 w-2/9">
                  Free Community (BYOK)
                </th>
                <th scope="col" class="py-4 px-6 text-xs font-mono uppercase tracking-wider text-emerald-300 bg-emerald-500/5 w-2/9">
                  Team Pro (Cloud)
                </th>
                <th scope="col" class="py-4 px-6 text-xs font-mono uppercase tracking-wider text-slate-200 w-2/9">
                  Enterprise
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800 text-sm">
              {comparisonMatrix.map((item) => (
                <tr class="hover:bg-slate-800/40 transition-colors">
                  <td class="py-4 px-6 font-medium text-white flex flex-col">
                    <span>{item.feature}</span>
                    <span class="text-[11px] font-mono text-slate-400 font-normal mt-0.5">{item.category}</span>
                  </td>
                  <td class="py-4 px-6 text-slate-300">
                    <span class="inline-flex items-center gap-1.5">
                      <span class="text-xs">{item.free}</span>
                    </span>
                  </td>
                  <td class="py-4 px-6 text-emerald-200 bg-emerald-500/5 font-medium">
                    <span class="inline-flex items-center gap-1.5">
                      <span class="text-xs">{item.team}</span>
                    </span>
                  </td>
                  <td class="py-4 px-6 text-slate-300">
                    <span class="inline-flex items-center gap-1.5">
                      <span class="text-xs">{item.enterprise}</span>
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Waitlist / Early Access Form -->
      <section id="waitlist-section" class="mb-24 scroll-mt-24" aria-label="Waitlist Signup">
        <div class="rounded-2xl border border-emerald-500/30 bg-gradient-to-br from-slate-900/90 via-slate-900/70 to-emerald-950/20 p-8 sm:p-12 relative overflow-hidden text-center max-w-3xl mx-auto shadow-2xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/25 text-emerald-400 text-xs font-mono uppercase tracking-widest mb-4">
            Early Access
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
            Be the first to access Team Cloud
          </h2>
          <p class="mt-3 text-slate-300 text-sm sm:text-base max-w-xl mx-auto leading-relaxed">
            Join 300+ engineering leads on the waitlist. Get early beta invitations, lock in founding team pricing ($8/user/mo grandfathered), and guide our feature roadmap.
          </p>

          <form
            class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3 max-w-md mx-auto"
            onsubmit="event.preventDefault(); const msg = document.getElementById('waitlist-success'); if (msg) { msg.classList.remove('hidden'); this.reset(); }"
          >
            <label for="waitlist-email" class="sr-only">Work email address</label>
            <input
              type="email"
              id="waitlist-email"
              name="email"
              required
              placeholder="you@company.com"
              class="w-full sm:w-auto flex-1 px-4 py-3 rounded-lg bg-slate-950/90 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-400 text-sm"
            />
            <button
              type="submit"
              class="w-full sm:w-auto px-6 py-3 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-sm shadow-lg shadow-emerald-500/25 transition-all duration-200 cursor-pointer shrink-0"
            >
              Notify Me
            </button>
          </form>

          <p id="waitlist-success" class="hidden mt-4 text-xs font-mono text-emerald-400 bg-emerald-500/10 border border-emerald-500/30 p-2.5 rounded-lg max-w-md mx-auto">
            ✓ You're on the list! We will send invite links when private beta opens.
          </p>

          <p class="mt-4 text-[11px] text-slate-400">
            Zero spam. Unsubscribe anytime. Strictly for release notifications.
          </p>
        </div>
      </section>

      <!-- FAQ Section -->
      <section class="max-w-3xl mx-auto mb-16" aria-label="Frequently Asked Questions">
        <div class="text-center mb-10">
          <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
            Frequently Asked Questions
          </h2>
          <p class="mt-2 text-sm text-slate-400">
            Common questions about licensing, privacy boundaries, and API credentials.
          </p>
        </div>

        <div class="space-y-4">
          {faqs.map((faq, idx) => (
            <details class="group rounded-xl border border-emerald-500/15 bg-slate-900/60 p-5 transition-colors duration-200 open:border-emerald-500/40">
              <summary class="flex items-center justify-between cursor-pointer list-none font-semibold text-base text-slate-100 group-hover:text-emerald-400 focus-visible:outline-2 focus-visible:outline-emerald-500 transition-colors">
                <span>{faq.question}</span>
                <span class="w-6 h-6 rounded-full bg-slate-800/80 border border-emerald-500/20 flex items-center justify-center shrink-0 text-emerald-400 group-open:rotate-180 transition-transform duration-200 ml-3">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </span>
              </summary>
              <p class="mt-3 text-sm text-slate-300 leading-relaxed pt-2 border-t border-slate-800/60">
                {faq.answer}
              </p>
            </details>
          ))}
        </div>
      </section>

      <!-- Bottom Open Source Reassurance Strip -->
      <section class="text-center border-t border-slate-800/80 pt-12">
        <div class="inline-flex items-center gap-3 px-4 py-2 rounded-xl bg-slate-900/80 border border-slate-800 text-xs text-slate-300">
          <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
          <span>Licensed under the <strong>MIT License</strong>. Free software forever. Developed with integrity.</span>
          <a href="https://github.com/sandeshPatel06/MiniTracker" target="_blank" rel="noopener noreferrer" class="text-emerald-400 underline hover:text-emerald-300 ml-1">Inspect Source Code</a>
        </div>
      </section>

    </div>
  </main>
</BaseLayout>
