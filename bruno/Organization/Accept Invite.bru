meta {
  name: Accept Invite
  type: http
  seq: 5
}

post {
  url: {{base_url}}/api/org/accept-invite
  body: json
  auth: none
}

body:json {
  {
    "token": "{{invite_token}}",
    "password": "teammatePassword123!",
    "name": "Jane Teammate"
  }
}

script:post-response {
  if (res.status === 200 && res.body && res.body.token) {
    bru.setEnvVar("token", res.body.token);
  }
}
