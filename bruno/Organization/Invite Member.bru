meta {
  name: Invite Member
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/org/invite
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "email": "teammate@example.com",
    "role": "member"
  }
}

script:post-response {
  if (res.status === 200 && res.body) {
    var invToken = res.body.token || res.body.invitation_token;
    if (invToken) {
      bru.setEnvVar("invite_token", invToken);
    }
  }
}
